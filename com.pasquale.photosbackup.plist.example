<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent template for the PhotosBackup daily checker. -->
<!-- Author: Pasquale Marzaioli -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pasquale.photosbackup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_PATH__/check_and_backup.sh</string>
    </array>

    <!-- Check daily at 09:00; check_and_backup.sh only runs the monthly backup when needed. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>__PROJECT_PATH__</string>

    <key>StandardOutPath</key>
    <string>__PROJECT_PATH__/backup.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_PATH__/backup_error.log</string>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
