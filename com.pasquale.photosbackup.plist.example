<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pasquale.photosbackup</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON_PATH__</string>
        <string>__PROJECT_PATH__/backup.py</string>
    </array>

    <!-- Run every 2nd of the month at 09:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>2</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>__PROJECT_PATH__</string>

    <key>StandardOutPath</key>
    <string>__PROJECT_PATH__/backup.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_PATH__/backup_error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
