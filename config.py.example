"""
Template settings for the Google Photos to OneDrive backup.

Author: Pasquale Marzaioli

Rename this file to `config.py` and fill in your credentials.
"""

import os

# --- Paths ---
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
TOKENS_DIR = os.path.join(BASE_DIR, ".tokens")
LOG_FILE = os.path.join(BASE_DIR, "backup.log")
TEMP_DIR = os.path.join(BASE_DIR, ".tmp_download")

# --- Optional Google Photos Library API ---
# The active backup uses the Chrome session saved by setup_auth.py.
# These credentials are only needed if you use google_photos.py directly.
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID = "YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET = "YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_TOKEN_FILE = os.path.join(TOKENS_DIR, "google_token.json")
GOOGLE_SCOPES = ["https://www.googleapis.com/auth/photoslibrary.readonly"]

# --- Microsoft OneDrive ---
# Get credentials from: https://portal.azure.com/
MICROSOFT_CLIENT_ID = "YOUR_MICROSOFT_CLIENT_ID"
MICROSOFT_TENANT_ID = "consumers"
MICROSOFT_TOKEN_FILE = os.path.join(TOKENS_DIR, "microsoft_token.json")
MICROSOFT_SCOPES = ["Files.ReadWrite"]

# --- OneDrive Folder Structure ---
# Example: Immagini/Memorie/2026/04.Aprile 2026
ONEDRIVE_ROOT_FOLDER = "Immagini/Memorie"

# --- Backup Schedule ---
# The LaunchAgent may run the checker every day; the checker only starts the
# monthly backup on or after this day.
BACKUP_NOT_BEFORE_DAY = 2

# --- Telegram ---
# Create a bot via @BotFather to get your token and chat ID.
TELEGRAM_BOT_TOKEN = "YOUR_BOT_TOKEN"
TELEGRAM_CHAT_ID = "YOUR_CHAT_ID"

# --- Concurrency ---
CONCURRENT_UPLOADS = 4
CONCURRENT_DELETES = 3

# --- Browser Download Reliability ---
BROWSER_HEADLESS = False
MUTE_BROWSER_AUDIO = True
MAX_SCROLL_ATTEMPTS = 120
SCROLL_IDLE_ROUNDS = 8
SCROLL_PAUSE_SECONDS = 1.0
SEARCH_SETTLE_SECONDS = 3.0
PHOTO_NAVIGATION_TIMEOUT_MS = 60000
GOOGLE_PHOTOS_TIMEOUT_MS = 60000
DOWNLOAD_TIMEOUT_MS = 120000
DOWNLOAD_RETRIES = 3

# --- Backup Safety ---
DELETE_AFTER_UPLOAD = True
DELETE_ON_PARTIAL_SUCCESS = False

# --- Post-Success Cleanup ---
CLEAN_RUNTIME_ARTIFACTS_AFTER_SUCCESS = True
CLEAN_CHROME_CACHE_AFTER_SUCCESS = True

# --- Network Retry Settings ---
REQUEST_RETRIES = 5
REQUEST_RETRY_BACKOFF_SECONDS = 2.0

# --- Month Names ---
MONTHS = {
    1: "Gennaio", 2: "Febbraio", 3: "Marzo", 4: "Aprile",
    5: "Maggio", 6: "Giugno", 7: "Luglio", 8: "Agosto",
    9: "Settembre", 10: "Ottobre", 11: "Novembre", 12: "Dicembre",
}
